# NEVPAZ Corporate LLM - Umgebungsvariablen
# Kopieren Sie diese Datei nach .env und tragen Sie Ihre Werte ein:
#   cp .env.example .env

# --- AWS Bedrock (EU Frankfurt) ---
AWS_ACCESS_KEY_ID=IHRE_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=IHRE_AWS_SECRET_ACCESS_KEY
AWS_REGION=eu-central-1

# Claude Sonnet 4.6 auf Bedrock EU
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6-20260214-v1:0

# Maximale Antwortlaenge in Tokens
MAX_TOKENS=4096
